on(touch) {
  touch.id = id;
  touch.key = key;
  touch.velocity = velocity;
  touch.count = touch.count + 1;
}

on(release) {
  touch.count = touch.count - 1;
}

on(modulate) {
  switch(level) {
    case 10..:
      touch.octave = -1;
      break;
    case 0:
      touch.octave = 0;
      break;
    case ..-10:
      touch.octave = 1;
      break;
  }

  if (touch.lastoctave != touch.octave) {
    touch.lastoctave = touch.octave;
    stop(id:touch.id);
    if (touch.count > 0)
      play(id:touch.id, key:touch.key, velocity:touch.velocity, octavemove:touch.octave);
  }

  if (touch.count == 0) stop(id:touch.id);
}

main() {
  touch.id = 0;
  touch.key = 0;
  touch.velocity = 0;
  touch.octave = 0;
  touch.lastoctave = 0;
  touch.count = 0;
}
